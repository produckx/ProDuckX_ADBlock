# Bắt buộc: bảo vệ /api/refresh (Vercel Cron tự gửi Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="Your_Key"

# Vercel Blob - cách A (khuyến nghị trên Vercel): Connect Blob store -> 2 biến này tự có
BLOB_STORE_ID="Key_On_Vercel_Blob_Store"

# Vercel Blob - cách B: token tĩnh (dùng khi chạy ngoài Vercel / CI)
BLOB_READ_WRITE_TOKEN="Key_On_Vercel_Blob_Read_Write"